{
  "name": "browsa",
  "version": "0.41.0",
  "private": true,
  "description": "Hand the current page to your AI agent — side-panel chat for Hermes, or any OpenAI-compatible API",
  "scripts": {
    "build": "node build/build.mjs",
    "watch": "node build/build.mjs --watch",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "package": "node build/package.mjs",
    "postversion": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('manifest.json','utf8'));m.version=require('./package.json').version;fs.writeFileSync('manifest.json',JSON.stringify(m,null,2)+'\\n');console.log('manifest.json synced to',m.version);\"",
    "check-compat": "bash check-compat.sh"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@firecrawl/pdf-inspector-wasm": "^0.1.1",
    "@rdkit/rdkit": "^2026.3.6",
    "@viz-js/viz": "^3.30.0",
    "docling.rs-wasm": "^1.58.0",
    "echarts": "^6.1.0",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.15.0",
    "molstar": "^5.12.0",
    "pdfjs-dist": "^6.1.200"
  }
}
