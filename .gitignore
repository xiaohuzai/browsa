# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Node (if user adds build tools later)
node_modules/
dist/
# _deps/ holds transient build-time npm packages, never ship
build/_deps/

# Vendor source cache (rebuilt via `npm run build`)
lib/_src/

# Distribution artifact (rebuilt via `npm run package`)
browsa-v*.zip

# Local config (do NOT commit real API keys)
config.local.json
.env
.env.local

# Test artifacts
*.log
coverage/
browsa.bundle

# Local tool caches (e.g. CodeGraph indexer) — machine-local, never for committing.
.codegraph/

# Session-local Claude config (permission allowlists, plans)
.claude/

# Pi channel transcripts (Feishu chat logs) - local only, never commit
.pi/

# dev-preview 截图产物（本地对比用，不入库）
dev-preview/shots/
# dev-preview 生成页（node dev-preview/gen.mjs 再生）
dev-preview/*.preview.html

# CWS 商店截图（上传 Chrome Web Store 用，本地生成不入库）
store-assets/
