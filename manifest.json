{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "browsa",
  "version": "0.35.11",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "homepage_url": "https://xiaohuzai.github.io/browsa/",
  "key": "",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "webNavigation",
    "alarms",
    "contextMenus",
    "downloads",
    "declarativeNetRequest",
    "cookies",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*"
      ],
      "js": [
        "lib/content-scripts/xhs-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "lib/content-scripts/selection-toolbar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://juejin.cn/*"
      ],
      "js": [
        "lib/content-scripts/juejin-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "lib/content-scripts/youtube-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "js": [
        "lib/content-scripts/zhihu-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.dedao.cn/*"
      ],
      "js": [
        "lib/content-scripts/dedao-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://time.geekbang.org/*"
      ],
      "js": [
        "lib/content-scripts/geektime-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "js": [
        "lib/content-scripts/bilibili-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://xueqiu.com/*",
        "https://www.xueqiu.com/*"
      ],
      "js": [
        "lib/content-scripts/xueqiu-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "lib/content-scripts/twitter-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.xiaoyuzhoufm.com/*",
        "https://xiaoyuzhoufm.com/*"
      ],
      "js": [
        "lib/content-scripts/xiaoyuzhou-content-script.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Open browsa sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Open browsa sidebar"
    }
  },
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/vendor/Readability.iife.js",
        "lib/vendor/Turndown.iife.js",
        "icons/icon16.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* http://*:* https://*:* ws://*:* wss://*:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-src 'none'; worker-src 'self'"
  }
}
